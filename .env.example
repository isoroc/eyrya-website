# Cloudflare Pages environment variables for the three form endpoints
# (functions/api/contact.js, wholesale.js, support.js).
#
# Set these in Cloudflare Dashboard -> Workers & Pages -> your Pages project ->
# Settings -> Variables and Secrets. Nothing here reaches the browser, so never
# prefix a secret with NEXT_PUBLIC_.
#
# This project has no database and no object storage, so there are no bindings
# to configure. The storefront is fully static and reads from lib/.

# --- Email (Resend) -----------------------------------------------------------
# Required by all three endpoints. Without it they answer HTTP 503
# "Server configuration error".
RESEND_API_KEY=re_your_resend_api_key

# Optional inbox overrides; each defaults to the matching address on eyrya.com.
CONTACT_EMAIL=support@eyrya.com
WHOLESALE_EMAIL=wholesale@eyrya.com
SUPPORT_EMAIL=support@eyrya.com
