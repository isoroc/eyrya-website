# Cloudflare Pages environment variables.
#
# Set these in Cloudflare Dashboard -> Workers & Pages -> your Pages project ->
# Settings -> Variables and Secrets. They are read by the Pages Functions in
# `functions/`. Nothing here reaches the browser, so never prefix a secret with
# NEXT_PUBLIC_.

# --- Email (Resend) -----------------------------------------------------------
# Required by /api/contact, /api/wholesale and /api/support. Without it those
# endpoints answer HTTP 503 "Server configuration error".
RESEND_API_KEY=re_your_resend_api_key

# Optional inbox overrides; each defaults to the matching address on eyrya.com.
CONTACT_EMAIL=support@eyrya.com
WHOLESALE_EMAIL=wholesale@eyrya.com
SUPPORT_EMAIL=support@eyrya.com

# --- Admin API ----------------------------------------------------------------
# Required by every /api/admin/* route, sent as `Authorization: Bearer <token>`
# from public/admin.html. When unset the whole Admin API fails closed with
# HTTP 503, so set it before deploying.
# Generate one with: openssl rand -base64 32
ADMIN_TOKEN=replace_me_with_a_long_random_secret

# --- Storage (R2) -------------------------------------------------------------
# Public base domain that serves the IMAGES_BUCKET contents, e.g.
# images.eyrya.com. Required by /api/admin/upload, which returns HTTP 503 when
# it is missing.
IMAGES_CUSTOM_DOMAIN=images.eyrya.com

# --- Bindings (configured in the Cloudflare dashboard, not here) --------------
# DB            -> D1 database (eyrya-db)
# IMAGES_BUCKET -> R2 bucket   (eyrya-images)
# Binding names must match wrangler.toml.
